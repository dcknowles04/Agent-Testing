# Copy to .env and fill in. With no key, the app runs in DEMO mode (canned responses).
ANTHROPIC_API_KEY=

# Model used by every agent. See https://docs.claude.com/en/docs/about-claude/models
CLAUDE_MODEL=claude-opus-5-5

# Thinking effort: low | medium | high. "low" keeps the live demo snappy (~10-25s per agent);
# "medium" or "high" gives richer letters but each step takes longer.
AGENT_EFFORT=low

# Seconds before a single agent call gives up and falls back to the canned response.
AGENT_TIMEOUT_S=90

# Ask the API to re-run a request on Anthropic's recommended fallback model if the
# primary model declines it (server-side "fallbacks": "default"). true/false.
CLAUDE_SERVER_FALLBACKS=true

# Pause (seconds) between steps in DEMO mode so the pipeline visibly lights up.
DEMO_STEP_DELAY_S=1.6

# Force demo mode even if a key is set (also toggleable from the UI header).
FORCE_DEMO_MODE=false

PORT=8000
